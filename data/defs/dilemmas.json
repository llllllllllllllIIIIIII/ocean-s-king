        { "id": "heave_to", "name": "顶风停船，等它过去",
          "text": "收帆、顶住 —— 这一夜就耗在这儿。",
          "effects": { "mood_all": 0.02, "tension": -0.06, "discipline": 0.02,
            "score": { "crew": 1 } }, "journal": "风暴里收帆顶住。" },
        { "id": "turn_back", "name": "掉头避一避",
          "text": "退几十海里，等风头过了再走。",
          "effects": { "mood_all": 0.05, "tension": -0.08, "discipline": -0.06,
            "score": { "voyage": -2, "crew": 1 } }, "journal": "风暴里掉头避风。" },
        { "id": "punish_fear", "name": "压住说回头的人",
          "text": "当众把话说死：谁再提回头，谁就下去。",
          "effects": { "mood_all": -0.09, "tension": 0.10, "discipline": 0.16,
            "score": { "history": -1 } }, "journal": "风暴里压住了「回头」这句话。" }
      ]
    },
