    {
      "id": "new_species", "name": "没见过的鸟", "priority": 1,
      "requires": { "ashore": true, "days_min": 5 },
      "effects": { "mood": 0.05,
        "message": "一只从来没有见过的鸟落在帆桁上，看了我们一会儿又飞走了。" },
      "text": "新大陆的鸟也是新的。",
      "knowledge": { "category": "species", "id": "unknown_bird", "title": "未知的鸟",
        "text": "红胸、长喙、不怕人。带回欧洲也许值钱。" }
    },
    {
      "id": "friendly_trade", "name": "一次交换", "priority": 2,
      "requires": { "ashore": true, "culture_stance": { "green_cape": "friendly" } },
