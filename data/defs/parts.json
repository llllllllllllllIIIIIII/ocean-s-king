{
  "_comment": "SVG 部件表。anchor 是部件画布内、应对准目标位置的像素点（docs/03 第 2 节的锚点规范）。",
  "version": 1,
  "units": { "svg_units_per_cell": 100 },
  "parts": {
    "hull_outline": { "file": "hull/hull_outline.svg", "anchor": [0, 0] },
