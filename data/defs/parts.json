    "deck_bulwark": { "file": "deck/deck_bulwark.svg", "anchor": [0, 0] },
    "interior_floor": { "file": "cabin/interior_floor.svg", "anchor": [0, 0] },
    "mast":         { "file": "rig/mast.svg",          "anchor": [60, 60] },
    "yard":         { "file": "rig/yard.svg",          "anchor": [780, 42] },
    "sail_main":    { "file": "sails/sail_main.svg",   "anchor": [40, 310] },
    "sail_jib":     { "file": "sails/sail_jib.svg",    "anchor": [30, 215] },
    "sail_main_reefed": { "file": "sails/sail_main_reefed.svg", "anchor": [40, 310],
