    "helm":         { "file": "fittings/helm.svg",     "anchor": [20, 60] },
    "capstan":      { "file": "fittings/capstan.svg",  "anchor": [80, 80] },
    "windlass":     { "file": "fittings/windlass.svg", "anchor": [120, 60] },
    "anchor_icon":  { "file": "fittings/anchor.svg",   "anchor": [80, 80] },
    "hatch":        { "file": "deck/hatch.svg",        "anchor": [60, 60] },
    "ladder":       { "file": "deck/ladder.svg",       "anchor": [60, 60] }
  }
